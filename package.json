{
  "name": "cardstacks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node scripts/runtime-test.mjs",
    "test:stacks": "esbuild scripts/stacks-test.mjs --bundle --platform=node --format=esm --outfile=dist-export-test/stacks-test.mjs && node dist-export-test/stacks-test.mjs",
    "test:export": "vite build --config vite.export.config.ts && node scripts/export-test.mjs",
    "verify": "npm run typecheck && npm run test:runtime && npm run test:stacks && npm run test:export && npm run build"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
